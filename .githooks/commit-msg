#!/bin/sh
#
# commit-msg — enforce Conventional Commits (dev/FEAT-0005, dev/ADR-0008).
#
# POSIX shell only: needing Node or Python to make a commit would be a poor
# trade. Installed by `make tools`, which sets core.hooksPath=.githooks.
#
# Accepted:
#   <type>(<scope>): <subject>
#
# Merge and revert commits pass through untouched — git writes those and their
# format is fixed. `refs FEAT-XXXX` is not enforced; requiring every commit to
# cite an item makes trivial fixes annoying and the cost of a miss is low.

set -u

MSG_FILE="$1"
TYPES='feat|fix|perf|refactor|test|docs|build|ci|chore'
MAX_SUBJECT=72

# The subject is the first line that is neither blank nor a comment, so a
# message written with a template or verbose diff still validates correctly.
SUBJECT=$(grep -v '^#' "$MSG_FILE" | grep -v '^[[:space:]]*$' | head -n 1)

# Nothing to validate: git aborts an empty commit message on its own.
if [ -z "$SUBJECT" ]; then
	exit 0
fi

# Generated by git; format is not ours to dictate.
case "$SUBJECT" in
Merge\ *|Revert\ *|fixup!\ *|squash!\ *|Reapply\ *)
	exit 0
	;;
esac

fail() {
	printf '\n  commit rejected: %s\n' "$1" >&2
	cat >&2 <<EOF

  Subject:
    $SUBJECT

  Expected:
    <type>(<scope>): <subject>

  Example:
    feat(ttl): add hierarchical time wheel

    Implements the four-level wheel with overflow handling for TTLs
    beyond 38 days.

    refs FEAT-0011

  Rules:
    type      one of: feat, fix, perf, refactor, test, docs, build, ci, chore
    scope     optional, lowercase package or subsystem, e.g. (storage)
    subject   imperative mood ("add", not "added"), no trailing period,
              $MAX_SUBJECT characters or fewer for the whole line

  Merge and revert commits are exempt. See dev/README.md section 7.

EOF
	exit 1
}

# Structure: type, optional (scope), colon, single space, non-empty subject.
if ! printf '%s' "$SUBJECT" | grep -Eq "^($TYPES)(\([a-z0-9._/-]+\))?!?: .+"; then
	case "$SUBJECT" in
	*": "*)
		fail "\"${SUBJECT%%:*}\" is not a known type" ;;
	*)
		fail "missing the \"<type>(<scope>): \" prefix" ;;
	esac
fi

LENGTH=${#SUBJECT}
if [ "$LENGTH" -gt "$MAX_SUBJECT" ]; then
	fail "subject line is $LENGTH characters, the limit is $MAX_SUBJECT"
fi

case "$SUBJECT" in
*.)
	fail "subject must not end with a period" ;;
esac

# Imperative mood: catch the endings that show up in practice. This is a
# heuristic, so it only rejects what is unambiguously wrong.
BODY=${SUBJECT#*: }
FIRST_WORD=$(printf '%s' "$BODY" | cut -d' ' -f1 | tr '[:upper:]' '[:lower:]')
case "$FIRST_WORD" in
added|adds|fixed|fixes|updated|updates|removed|removes|changed|changes|\
implemented|implements|refactored|refactors|renamed|renames|moved|moves|\
created|creates|deleted|deletes|bumped|bumps)
	fail "subject must be imperative mood: write \"add\", not \"$FIRST_WORD\"" ;;
esac

exit 0
