# Binaries
bin/
# Parallel builds use their own BUILD_DIR so concurrent work cannot race on the
# shared binary. Those directories are build output like bin/ is.
bin-*/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html
coverage-sdk.html

# Profiling
*.prof
cpu.out
mem.out

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# Logs
*.log
logs/

# Data directory (for local testing)
data/
/var/lib/atlascache/

# Config with secrets (keep example)
config.yaml
!config.example.yaml

# Development TLS material from `make dev-certs`. Never commit a certificate or
# a key: committed test certificates get copied into production, and they expire.
#
# Anchored to the repository root, so it ignores what `make dev-certs` writes
# and not the Go package at test/e2e/certs.
/certs/
*.pem
*.crt
*.key

# Temporary files
tmp/
temp/

# Internal planning workspace (SOW, phase plans, features, issues, ADRs, worklogs).
# Everything under dev/ is private. Public docs live in docs/.
/dev/
# Stray tool binaries built into the repo root
/phasecheck
/devindex
/atlas-e2e
/atlasctl

# GoReleaser output. Everything a release would publish, rebuilt from scratch
# by `make release-dry-run` and never committed.
dist/
